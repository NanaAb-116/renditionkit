{
  "name": "@renditionkit/cli",
  "version": "0.1.0",
  "description": "Configuration-driven worker command for RenditionKit.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NanaAb-116/renditionkit.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/NanaAb-116/renditionkit/issues"
  },
  "homepage": "https://github.com/NanaAb-116/renditionkit/tree/main/packages/cli#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "renditionkit-worker": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@renditionkit/bullmq": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
