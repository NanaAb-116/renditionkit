{
  "name": "@renditionkit/image",
  "version": "0.1.0",
  "description": "Sharp-based image inspection and responsive rendition engine for RenditionKit.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@renditionkit/core": "workspace:^",
    "sharp": "^0.34.4",
    "thumbhash": "^0.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
