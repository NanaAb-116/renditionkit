  "description": "S3, Cloudflare R2, and MinIO object-storage adapter for RenditionKit.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NanaAb-116/renditionkit.git",
    "directory": "packages/storage-s3"
  },
  "bugs": {
    "url": "https://github.com/NanaAb-116/renditionkit/issues"
  },
