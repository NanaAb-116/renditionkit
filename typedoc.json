{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "packages/core",
    "packages/image",
    "packages/bullmq",
    "packages/storage-s3",
    "packages/repository-postgres"
  ],
  "entryPointStrategy": "packages",
  "packageOptions": {
    "gitRevision": "main"
  },
  "out": "docs/api",
  "plugin": ["typedoc-plugin-markdown"],
  "readme": "none",
  "githubPages": false,
  "excludePrivate": true,
  "excludeInternal": true
}
